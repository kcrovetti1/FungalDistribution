label = "No data available for this family",
size = 5
) +
theme_void()
)
}
ggplot(
data_plot,
aes(
axis1 = `Family/species`,
axis2 = country,
axis3 = Gene,
axis4 = Mutation,
y = count
)
) +
geom_alluvium(
aes(fill = Gene),
alpha = 0.8
) +
geom_stratum() +
geom_text(
stat = "stratum",
aes(label = after_stat(stratum)),
size = 3
) +
scale_x_discrete(
limits = c(
"Family",
"Country",
"Gene",
"Mutation"
),
expand = c(.1, .1)
) +
scale_y_continuous(
expand = c(0, 0)
) +
theme_bw() +
labs(
title = paste(
"FEL -",
input$selected_family
),
y = "Count",
fill = "Gene"
)
})
