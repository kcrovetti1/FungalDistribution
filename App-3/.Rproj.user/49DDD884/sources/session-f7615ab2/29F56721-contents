      str_detect(country, "China ") ~ "China",
      TRUE ~ country
    )
  ) %>%
  filter(!is.na(country), country != "China")
sample_counts <- Fungal_AMR_Taxonomy2 %>%
  count(country, name = "samples")
HighFreqMutations <- Fungal_AMR_Taxonomy2 %>%
  filter(!is.na(mutation)) %>%
  count(mutation, sort = TRUE) %>%
  filter(n >= 40) %>%
  pull(mutation)
Mutation_Ratios <- Fungal_AMR_Taxonomy2 %>%
  filter(!is.na(mutation)) %>%
  filter(mutation %in% HighFreqMutations) %>%
  count(country, mutation) %>%
  group_by(country) %>%
  mutate(prop = n / sum(n)) %>%
  ungroup()
world <- ne_countries(scale = "medium", returnclass = "sf")
world_joined <- world %>%
  inner_join(sample_counts, by = c("name" = "country"))

sf_use_s2(FALSE)
world_joined <- st_make_valid(world_joined)
pie_positions <- world_joined %>%
  st_point_on_surface() %>%
  mutate(
    lon = st_coordinates(.)[,1],
    lat = st_coordinates(.)[,2]
  ) %>%
  st_drop_geometry() %>%
  select(name, lon, lat)
mutation_plot_data <- Mutation_Ratios %>%
  inner_join(pie_positions, by = c("country" = "name")) %>%
  filter(!is.na(lon), !is.na(lat)) %>%
  group_by(country) %>%
  arrange(mutation) %>%
  mutate(
    start = 2 * pi * cumsum(prop) - 2 * pi * prop,
    end = 2 * pi * cumsum(prop)
