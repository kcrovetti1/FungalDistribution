#-------------------------------------------------------------------------------
  
  Fungal_AMR_Taxonomy <- Fungal_AMR_Taxonomy %>%
    mutate(country = if_else(is.na(geographic_region) | geographic_region == "",
                             NA_character_,
                             str_split(geographic_region, ":") %>% map_chr(1)),
           country = case_when(
             country %in% c("USA") ~ "United States of America",
             country %in% c("Brazil Brazil") ~ "Brazil",
             country %in% c("China,Nanjing,Jiangsu") ~ "China",
             country %in% c("UK") ~ "United Kingdom",
             country %in% c("China ") ~ "China",
             TRUE ~ country
           ))
  
  sample_counts <- Fungal_AMR_Taxonomy %>%
    filter(!is.na(country)) %>%
    count(country, name = "samples")
  
  HighFreqMutations <- Fungal_AMR_Taxonomy %>%
    filter(!is.na(mutation)) %>%
    count(mutation, sort = TRUE) %>%
    filter(n >= 40) %>%
    pull(mutation)
  
  Mutation_Ratios<- Fungal_AMR_Taxonomy%>%
    filter(!is.na(country), !is.na(mutation)) %>%
    filter(mutation %in% HighFreqMutations) %>% 
    count(country,mutation) %>%  
    group_by(country) %>%
    mutate(prop = n / sum(n)) %>%
    ungroup()
  
    world <- ne_countries(scale = "medium", returnclass = "sf")
    
    world_joined <- world %>%
      inner_join(sample_counts, by = c("name" = "country"))
    
    sf_use_s2(FALSE)
    world_joined <- st_make_valid(world_joined)
    
    pie_positions <- world_joined %>%
      st_point_on_surface() %>%
      mutate(
        lon = st_coordinates(.)[,1],
        lat = st_coordinates(.)[,2]
      ) %>%
      st_drop_geometry() %>%
      select(name, lon, lat)
  
    mutation_plot_data <- Mutation_Ratios %>%
      inner_join(pie_positions, by = c("country" = "name")) %>%
      filter(!is.na(lon), !is.na(lat)) %>%
      group_by(country) %>%
      arrange(mutation) %>%
      mutate(
        start = 2 * pi * cumsum(prop) - 2 * pi * prop,
        end = 2 * pi * cumsum(prop)
      ) %>%
      ungroup()
    
  ggplot() +
    
    geom_sf(
      data = world_joined,
      aes(fill = samples),
      color = "grey40"
    ) +
    scale_fill_viridis_c(
      option = "plasma",
      na.value = "grey90",
      name = "Number of Samples"
    ) +
    
    
    ggnewscale::new_scale_fill() +
    
    
    geom_arc_bar(
      data = mutation_plot_data,
      aes(
        x0 = lon, y0 = lat,
        r0 = 0,
        r = 3,
        start = start,
        end = end,
        fill = mutation
      ),
      color = "black",
      linewidth = 0.2,
      alpha = 0.95
    ) +
    scale_fill_viridis_d(
      option = "plasma",
      name = "mutation"
    ) +
    
    
    theme_minimal() +
    labs(title = "Distribution of Prominent Mutations") +
    coord_sf()
  
